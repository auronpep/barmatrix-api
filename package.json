{
  "name": "barmatrix-api",
  "version": "0.1.0",
  "private": true,
  "description": "BarMatrix.app backend API — Express + TypeScript + mysql2 + Stripe + Clerk. Deploys to Hostinger, backed by Hostinger MySQL.",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "postbuild": "node scripts/copy-data.mjs",
    "start": "node --import ./dist/sentry-init.js dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "migrate": "node scripts/apply-schema.mjs",
    "knowledge:search": "tsx src/scripts/query-knowledge.ts"
  },
  "dependencies": {
    "@clerk/express": "^1.4.0",
    "@sentry/node": "^10.55.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "mysql2": "^3.22.4",
    "resend": "^6.12.4",
    "stripe": "^17.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "yaml": "^2.9.0"
  }
}
